@model IEnumerable<Student>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Quản lý danh sách sinh viên</h2>
        <div class="btn-group">
            <a asp-action="Create" class="btn btn-primary">Create Student</a>
            <a asp-route="student_add" class="btn btn-outline-primary">asp-route</a>
            <a href="/Admin/Student/Add" class="btn btn-outline-secondary">href thuần</a>
        </div>
    </div>

    <table class="table table-striped table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Mã</th>
                <th>Ảnh</th>
                <th>Họ tên</th>
                <th>Ngày sinh</th>
                <th>Ngành</th>
                <th>Giới tính</th>
                <th>Hệ ĐT</th>
                <th>Địa chỉ</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Id</td>
                    <td class="text-center">
                        @if (!string.IsNullOrEmpty(s.AvatarUrl))
                        {
                            <img src="@s.AvatarUrl" alt="Avatar" style="width: 45px; height: 45px; object-fit: cover; border-radius: 50%;" />
                        }
                        else
                        {
                            <img src="/images/default-avatar.png" alt="Avatar" style="width: 45px; height: 45px; object-fit: cover; border-radius: 50%;" />
                        }
                    </td>
                    <td>@s.Name</td>
                    <td>@s.DateOfBorth</td>
                    @{
                        string str = "";
                        switch (s.Branch)
                        {
                            case Branch.IT:
                                str = "CNTT";
                                break;
                            case Branch.BE:
                                str = "Kinh tế";
                                break;
                            case Branch.CE:
                                str = "Công trình";
                                break;
                            case Branch.EE:
                                str = "Điện - Điện tử";
                                break;
                        }
                    }
                    <td>@str</td>
                    <td>@(s.Gender == Gender.Male ? "Nam" : "Nữ")</td>
                    <td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                    <td>@s.Address</td>
                    <td>@s.Email</td>
                </tr>
            }
        </tbody>
    </table>
</div>
