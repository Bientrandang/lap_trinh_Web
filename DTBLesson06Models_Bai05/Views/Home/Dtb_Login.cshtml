@model DTBLesson06Models.Models.Dtb_Login

<h2>Model Binding - Login</h2>

@if (ViewBag.Message != null)
{
    <p class="text-danger">@ViewBag.Message</p>
}

<form asp-action="Login" method="post">
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label asp-for="DtbUserName">UserName</label>
        <input asp-for="DtbUserName" />
    </div>

    <div class="form-group">
        <label asp-for="DtbPassword">Password</label>
        <input asp-for="DtbPassword" type="password" />
    </div>

    <button class="btn" type="submit">Submit</button>
</form>

<p>Thông tin mẫu: Peter / pass@123</p>
