@model IEnumerable<DTBLesson06Models.Models.Dtb_User>

<h2>Danh sách User</h2>

<p>
    <a class="btn" asp-action="Create">Thêm User</a>
</p>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Họ tên</th>
            <th>Địa chỉ</th>
            <th>Email</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.DtbId</td>
            <td>@user.DtbName</td>
            <td>@user.DtbAddress</td>
            <td>@user.DtbEmail</td>
            <td>
                <a class="btn" asp-action="Details" asp-route-id="@user.DtbId">Details</a>
                <a class="btn" asp-action="Edit" asp-route-id="@user.DtbId">Edit</a>
                <a class="btn" asp-action="Delete" asp-route-id="@user.DtbId">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
