@model IEnumerable<DangTranBien_241224469.Models.HangHoa>

<div class="content">
    <!-- Begin Content Header -->
    <div class="content_top">
        <div class="heading">
            <h3>DangTranBien</h3>
        </div>
        <div class="see">
            <p><a asp-controller="HangHoa" asp-action="Create">See all Products</a></p>
        </div>
        <div class="clear"></div>
    </div>
    
    <!-- Begin Product Grid -->
    <div class="section group">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="grid_1_of_4 images_1_of_4">
                    <a href="javascript:void(0)"><img src="~/images/@item.Anh" alt="@item.TenHang" style="height: 150px; object-fit: contain;" /></a>
                    <h2>@item.TenHang</h2>
                    <div class="price-details">
                        <div class="price-number">
                            <p><span class="rupees">@string.Format("{0:0}", item.Gia)</span></p>
                        </div>
                        <div class="add-cart">								
                            <h4><a href="javascript:void(0)">Add to Cart</a></h4>
                        </div>
                        <div class="clear"></div>
                    </div>					 
                </div>
            }
        }
        else
        {
            <div style="padding: 30px; font-size: 15px; color: #555;">
                <p>Không có sản phẩm nào có giá &gt;= 100.</p>
            </div>
        }
        <div class="clear"></div>
    </div>
</div>
