@model IEnumerable<DangTranBien_241224469.Models.Sach>

<div class="grid" id="book-grid">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            <div class="book-card">
                <a href="#"><img src="~/images/@item.Anh" alt="@item.TenSach" /></a>
                <h2>@item.TenSach</h2>
                <div class="book-foot">
                    <span class="price">@Convert.ToInt32(item.Gia)</span>
                    <button class="btn-buy" type="button">Thêm vào giỏ</button>
                </div>
            </div>
        }
    }
    else
    {
        <p style="grid-column: 1 / -1; padding: 30px; text-align: center; color: #666; font-size: 15px;">
            Không có sách nào trong mục này.
        </p>
    }
</div>
