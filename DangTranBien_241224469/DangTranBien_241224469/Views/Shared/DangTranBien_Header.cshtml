@inject DangTranBien_241224469.Models.QLHangHoaContext _context
@{
    var loaiHangs = _context.LoaiHangs.OrderBy(l => l.MaLoai).ToList();
    var selectedMaLoai = (int?)ViewBag.SelectedMaLoai ?? 0;
}

<!-- Begin Header -->
<div class="header">
    <div class="header_top">
        <div class="logo">
            <a asp-controller="Home" asp-action="Index"><img src="~/images/logo.png" alt="Home Shoppe" /></a>
        </div>
        <div class="cart">
            <p>
                Welcome to our Online Store! <span>Cart:</span>
                <a asp-controller="HangHoa" asp-action="Create" style="margin-left: 10px; font-weight: bold; color: #B81D22; text-decoration: underline;">[Thêm Hàng Hóa Mới]</a>
                <div id="dd" class="wrapper-dropdown-2"> 0 item(s) - $0.00
                    <ul class="dropdown">
                        <li>you have no items in your Shopping cart</li>
                    </ul>
                </div>
            </p>
        </div>		
        <div class="clear"></div>
    </div>
    <div class="header_bottom">
        <div class="menu">
            <ul>
                <li class="@(selectedMaLoai == 0 ? "active" : "")" id="menu-home">
                    <a href="javascript:void(0)" onclick="loadHangHoaByLoai(0, this)">DangTranBien</a>
                </li>
                @foreach (var loai in loaiHangs)
                {
                    <li class="@(selectedMaLoai == loai.MaLoai ? "active" : "")" id="menu-loai-@loai.MaLoai">
                        <a href="javascript:void(0)" onclick="loadHangHoaByLoai(@loai.MaLoai, this)">@loai.TenLoai</a>
                    </li>
                }
                <div class="clear"></div>
            </ul>
        </div>
        <div class="search_box">
            <form>
                <input type="text" value="Search" onfocus="this.value = '';" onblur="if (this.value == '') {this.value = 'Search';}">
                <input type="button" value="">
            </form>
        </div>
        <div class="clear"></div>
    </div>	     
</div>
<!-- End Header -->

<script type="text/javascript">
    function loadHangHoaByLoai(maLoai, element) {
        $('.menu ul li').removeClass('active');
        $(element).parent().addClass('active');

        if ($('#mainContentArea').length > 0) {
            $.ajax({
                url: '@Url.Action("GetHangHoaByLoai", "Home")',
                type: 'GET',
                data: { maLoai: maLoai },
                success: function(data) {
                    $('#mainContentArea').html(data);
                },
                error: function(xhr, status, error) {
                    console.error("Lỗi khi tải hàng hóa: " + error);
                }
            });
        } else {
            window.location.href = '/?maLoai=' + maLoai;
        }
    }
</script>
