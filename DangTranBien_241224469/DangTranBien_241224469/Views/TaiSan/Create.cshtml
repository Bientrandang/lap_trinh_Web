@model DangTranBien_241224469.Models.TaiSan

@{
    ViewData["Title"] = "Thêm tài sản mới";
}

<div class="container">
    <div class="create-card">
        <h2>THÊM TÀI SẢN MỚI</h2>

        <form asp-controller="TaiSan" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group-row">
                <label asp-for="MaLoai" class="form-label-col">Loại tài sản</label>
                <div class="form-input-col">
                    <select asp-for="MaLoai" class="form-control-custom" asp-items="ViewBag.MaLoai">
                        <option value="">-- Chọn loại tài sản --</option>
                    </select>
                    <span asp-validation-for="MaLoai" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group-row">
                <label asp-for="TenTs" class="form-label-col">Tên tài sản</label>
                <div class="form-input-col">
                    <input asp-for="TenTs" class="form-control-custom" placeholder="Nhập tên tài sản..." />
                    <span asp-validation-for="TenTs" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group-row">
                <label asp-for="NguyenGia" class="form-label-col">Nguyên giá (triệu)</label>
                <div class="form-input-col">
                    <input asp-for="NguyenGia" class="form-control-custom" type="number" step="any" placeholder="Nhập nguyên giá (triệu đồng)..." />
                    <span asp-validation-for="NguyenGia" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group-row">
                <label asp-for="Anh" class="form-label-col">Tên file ảnh</label>
                <div class="form-input-col">
                    <input asp-for="Anh" class="form-control-custom" placeholder="Ví dụ: Img_1.jpg" />
                    <span asp-validation-for="Anh" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group-row" style="margin-top: 20px;">
                <div class="form-label-col"></div>
                <div class="form-input-col">
                    <button type="submit" class="btn-create-submit">Create</button>
                    <a asp-controller="Home" asp-action="Index" style="margin-left: 15px; color: #1d3f72; font-size: 13px; text-decoration: underline;">Quay lại</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
