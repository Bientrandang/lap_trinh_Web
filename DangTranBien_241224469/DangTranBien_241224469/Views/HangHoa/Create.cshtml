@model DangTranBien_241224469.Models.HangHoa

@{
    ViewData["Title"] = "Thêm Hàng Hóa Mới - DangTranBien";
    Layout = "DangTranBien_Layout";
}

<div class="create-form-container">
    <h2>DangTranBien</h2>
    <h4>Thêm Hàng Hóa Mới</h4>
    <hr />
    <div style="max-width: 400px;">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group">
                <label asp-for="MaLoai" class="control-label">MaLoai</label>
                <select asp-for="MaLoai" class="form-control" asp-items="ViewBag.MaLoai"></select>
                <span asp-validation-for="MaLoai" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TenHang" class="control-label">TenHang</label>
                <input asp-for="TenHang" class="form-control" />
                <span asp-validation-for="TenHang" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Gia" class="control-label">Gia</label>
                <input asp-for="Gia" class="form-control" type="text" />
                <span asp-validation-for="Gia" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Anh" class="control-label">Anh</label>
                <input asp-for="Anh" class="form-control" placeholder="ví dụ: Img_1.jpg" />
                <span asp-validation-for="Anh" class="text-danger"></span>
            </div>

            <div class="form-group" style="margin-top: 20px;">
                <input type="submit" value="Create" class="btn-create" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
